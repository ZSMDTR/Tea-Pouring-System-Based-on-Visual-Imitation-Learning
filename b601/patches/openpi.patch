+def _read_kib_file(path):
+    values = {}
+    with open(path) as f:
+        for line in f:
+            if ":" not in line:
+                continue
+            key, value = line.split(":", 1)
+            fields = value.strip().split()
+            if fields and fields[0].isdigit():
+                values[key] = int(fields[0])
+    return values
+
+
+def _log_checkpoint_memory(label):
+    status = _read_kib_file("/proc/self/status")
+    meminfo = _read_kib_file("/proc/meminfo")
+
+    vmrss = status.get("VmRSS", 0) / 1024**2
+    anon = status.get("RssAnon", 0) / 1024**2
+    rss_file = status.get("RssFile", 0) / 1024**2
+    shmem = status.get("RssShmem", 0) / 1024**2
+
+    total = meminfo.get("MemTotal", 0)
+    avail = meminfo.get("MemAvailable", 0)
+    system_used = (total - avail) / 1024**2
+
+    swap_total = meminfo.get("SwapTotal", 0)
+    swap_free = meminfo.get("SwapFree", 0)
+    swap_used = (swap_total - swap_free) / 1024**2
+
+    logging.info(
+        "[MEMPROBE] %s | "
+        "VmRSS=%.3fGiB RssAnon=%.3fGiB RssFile=%.3fGiB "
+        "RssShmem=%.3fGiB system_used=%.3fGiB swap_used=%.3fGiB",
+        label,
+        vmrss,
+        anon,
+        rss_file,
+        shmem,
+        system_used,
+        swap_used,
+    )
+
+
+def _malloc_trim():
+    if _LIBC is None or not hasattr(_LIBC, "malloc_trim"):
+        return None
+    return int(_LIBC.malloc_trim(0))
+
+
+
+def _wait_checkpoint_futures(futures):
+    """Waits for checkpoint futures in a separate Python scope.
+
+    Keeping the loop variable inside this helper is intentional: after this
+    function returns there must be no caller-local reference to the final
+    ChainedFuture.
+    """
+    for checkpoint_future in futures:
+        checkpoint_future.result()
+
+
+async def _serial_composite_async_save(self, directory, args):
+    """Serial version of Orbax 0.11.23 CompositeCheckpointHandler.async_save.
+
+    This intentionally preserves Orbax's existing temporary-directory,
+    metadata, finalize, and atomic-rename machinery.
+
+    Only the scheduling changes:
+
+        params
+          -> wait for all commit futures
+        train_state
+          -> wait for all commit futures
+        assets
+          -> wait for completion
+
+    This is inspired by Orbax Partial Saving: disjoint checkpoint pieces are
+    fully committed one at a time before starting the next large piece.
+    """
+    start_time = time.time()
+
+    self._current_temporary_paths = self._get_item_temporary_paths(
+        directory, args
+    )
+
+    # Directory creation must be complete before the first item starts.
+    if self._async_options.create_directories_asynchronously:
+        directory_future = _orbax_composite.atomicity.create_all_async(
+            list(self._current_temporary_paths.values()),
+            completion_signals=_orbax_composite._DIRECTORY_CREATION_SIGNALS,
+            multiprocessing_options=self._multiprocessing_options,
+        )
+        directory_future.result()
+    else:
+        future.CommitFutureAwaitingContractedSignals(
+            _orbax_composite.atomicity.create_all(
+                list(self._current_temporary_paths.values()),
+                multiprocessing_options=self._multiprocessing_options,
+            )
+        ).result()
+
+    # Explicit order. The two large items must NOT overlap.
+    preferred_order = ("params", "train_state", "assets")
+    item_order = [
+        name
+        for name in preferred_order
+        if name in self._current_temporary_paths
+    ]
+    item_order.extend(
+        name
+        for name in self._current_temporary_paths
+        if name not in item_order
+    )
+
+    logging.info(
+        "[SERIAL_CKPT] item order: %s",
+        " -> ".join(item_order),
+    )
+
+    for item_name in item_order:
+        item_start = time.time()
+
+        item_directory = self._current_temporary_paths[item_name]
+        arg = args[item_name]
+
+        _orbax_composite._maybe_raise_reserved_item_error(item_name)
+        handler = self._get_or_set_handler(item_name, arg)
+
+        _log_checkpoint_memory(f"BEFORE {item_name}")
+
+        logging.info(
+            "[SERIAL_CKPT] START item=%s",
+            item_name,
+        )
+
+        if isinstance(handler, _orbax_composite.AsyncCheckpointHandler):
+            # IMPORTANT:
+            # Awaiting async_save() alone is not sufficient. It returns commit
+            # futures whose writes may still be in progress.
+            item_futures = await handler.async_save(
+                item_directory.get(),
+                args=arg,
+            )
+
+            flat_futures = (
+                jax.tree.flatten(item_futures)[0]
+                if item_futures is not None
+                else []
+            )
+
+            logging.info(
+                "[SERIAL_CKPT] WAIT item=%s futures=%d",
+                item_name,
+                len(flat_futures),
+            )
+
+            # This is the actual serialization barrier.
+            # Do not start the next checkpoint item until every write/commit
+            # belonging to this item is complete.
+            _wait_checkpoint_futures(flat_futures)
+
+            # Important: release every Python reference to ChainedFuture before
+            # gc.collect()/malloc_trim(). ChainedFuture itself retains its
+            # internal futures even after result() has completed.
+            del flat_futures
+            del item_futures
+
+        else:
+            # Preserve Orbax's original blocking-handler behavior.
+            future.CommitFutureAwaitingContractedSignals(
+                asyncio.to_thread(
+                    handler.save,
+                    item_directory.get(),
+                    args=arg,
+                )
+            ).result()
+
+        # Measure host-memory lifetime after the item's writes have really
+        # committed, but before starting the next large PyTree.
+        _log_checkpoint_memory(f"AFTER_COMMIT {item_name}")
+        if item_name == "params":
+            _orbax_replica_slices._openpi_log_host_buffer_registry(
+                "AFTER_COMMIT params"
+            )
+
+        collected = gc.collect()
+        logging.info(
+            "[MEMPROBE] gc.collect item=%s collected=%d",
+            item_name,
+            collected,
+        )
+        _log_checkpoint_memory(f"AFTER_GC {item_name}")
+        if item_name == "params":
+            _orbax_replica_slices._openpi_log_host_buffer_registry(
+                "AFTER_GC params"
+            )
+
+        # For the 12.5-GiB EMA params item, explicitly ask glibc to return
+        # unused arenas/pages to the kernel and give the system 10 seconds
+        # before train_state starts.
+        if item_name == "params":
+            trim_result = _malloc_trim()
+            logging.info(
+                "[MEMPROBE] malloc_trim item=params returned=%s",
+                trim_result,
+            )
+            _log_checkpoint_memory("AFTER_MALLOC_TRIM params")
+            _orbax_replica_slices._openpi_log_host_buffer_registry(
+                "AFTER_MALLOC_TRIM params"
+            )
+
+            logging.info(
+                "[MEMPROBE] sleeping 10s before train_state"
+            )
+            time.sleep(10)
+            _log_checkpoint_memory("AFTER_10S params")
+            _orbax_replica_slices._openpi_log_host_buffer_registry(
+                "AFTER_10S params"
+            )
+
+            raise RuntimeError(
+                "V7.5 HOSTBUF PARAMS-ONLY PROBE COMPLETE -- intentional stop"
+            )
+
+        logging.info(
+            "[SERIAL_CKPT] DONE item=%s elapsed=%.3fs",
+            item_name,
+            time.time() - item_start,
+        )
+
+    logging.info(
+        "[SERIAL_CKPT] all items committed in %.3fs; "
+        "returning to Orbax for normal Composite finalize",
+        time.time() - start_time,
+    )
+
+    # Every item's commit futures have already completed.
+    # Returning no outstanding futures makes the outer Checkpointer proceed
+    # directly to Orbax's existing metadata/finalize/atomic-rename path.
+    return []
+
+
+# Compatibility patch for the OpenPI-pinned Orbax 0.11.23 implementation.
+# Restore behavior is untouched; only Composite save scheduling is changed.
+_orbax_composite.CompositeCheckpointHandler.async_save = (
+    _serial_composite_async_save
+)
