{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${workspaceFolder}/.vscode-cache/browse.vc.db",
        "limitSymbolsToIncludedHeaders": true,
        "path": [
          "${workspaceFolder}/src",
          "/opt/ros/humble/include"
        ]
      },
      "includePath": [
        "${workspaceFolder}/src",
        "/opt/ros/humble/include"
      ],
      "name": "ros2",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}
